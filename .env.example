# Copiez ce fichier en .env pour un usage local : cp .env.example .env
# En production, ces variables se saisissent dans l'écran « Environment variables » de la stack Portainer.

APP_PORT=3000

POSTGRES_USER=evenements
POSTGRES_PASSWORD=evenements
POSTGRES_DB=evenements

# Clé de signature des sessions de connexion. Mettez une valeur longue et
# aléatoire en production (ex. openssl rand -hex 32) : quiconque la connaît
# peut fabriquer un cookie de connexion valide.
SESSION_SECRET=changez-cette-cle-en-production
